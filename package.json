{
  "name": "syslens",
  "productName": "SysLens",
  "version": "1.4.1",
  "private": true,
  "description": "SysLens, the better Task Manager for Windows: every process with Task Manager’s actions and more, where your RAM really goes, what fills your disk, what starts with Windows and what your PC did while you were away.",
  "homepage": "https://github.com/seoedw/syslens-the-better-task-manager#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/seoedw/syslens-the-better-task-manager.git"
  },
  "license": "MIT",
  "author": "seoedw (https://github.com/seoedw)",
  "main": "src/main/launcher.js",
  "scripts": {
    "start": "node --jitless src/main/launcher.js",
    "dev": "node src/main/server.js --no-window",
    "selftest": "node scripts/selftest.js",
    "icon": "node scripts/make-icon.js",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-shortcut.ps1 -Desktop",
    "portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-portable.ps1 -Zip"
  },
  "dependencies": {
    "koffi": "^3.3.8"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "syslens": {
    "channel": "beta",
    "author": "seoedw",
    "discord": "eward.s.asdfjkl"
  }
}
