{
  "name": "syslens",
  "productName": "SysLens",
  "version": "1.2.0",
  "private": true,
  "description": "SysLens, the better Task Manager for Windows: every process, where your RAM really goes, what fills your disk, what starts with Windows and what your PC did while you were away.",
  "homepage": "https://github.com/seoedw/syslens-the-better-task-manager#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/seoedw/syslens-the-better-task-manager.git"
  },
  "main": "src/main/launcher.js",
  "scripts": {
    "start": "node --jitless src/main/launcher.js",
    "dev": "node src/main/server.js --no-window",
    "selftest": "node scripts/selftest.js",
    "icon": "node scripts/make-icon.js",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-shortcut.ps1 -Desktop"
  },
  "dependencies": {
    "koffi": "^3.3.8"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ]
}
