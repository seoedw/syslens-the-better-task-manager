{
  "name": "syslens",
  "productName": "SysLens",
  "version": "1.1.0",
  "private": true,
  "description": "A better Task Manager for Windows: every process, exactly where your RAM goes, and what fills your disk.",
  "main": "src/main/launcher.js",
  "scripts": {
    "start": "node --jitless src/main/launcher.js",
    "dev": "node src/main/server.js --no-window",
    "selftest": "node scripts/selftest.js",
    "icon": "node scripts/make-icon.js",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-shortcut.ps1 -Desktop"
  },
  "dependencies": {
    "koffi": "^3.3.8"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ]
}
